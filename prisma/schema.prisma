// Prisma schema for AI Digital Twin Platform (Phase 1 MVP).
// Exact contract: docs/DataModel.md — do not rename fields/enum values without updating that file first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkflowType {
  SUPPORT_REPLY
  SALES_EMAIL
  CONTRACT_REVIEW
}

enum TaskStatus {
  NEW
  AI_DRAFTING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EDITED
  ESCALATED
  CLOSED
}

enum DecisionAction {
  APPROVE
  REJECT
  EDIT_APPROVE
  ESCALATE
}

enum EvalTagValue {
  GOOD
  NEEDS_EDIT
  BAD
}

// MonetizationPlan.md Step 1. DEMO is the default for every user, including
// everyone who signed up before this feature existed — the demo task cap
// (Step 2) applies retroactively to them, per that step's explicit decision.
enum Plan {
  DEMO
  INDIVIDUAL
  PROFESSIONAL
  ENTERPRISE
}

// MonetizationPlan.md Step 1. NONE = never subscribed (every DEMO user
// starts here). PAST_DUE = a renewal charge failed (see the invoice.
// payment_failed webhook handler, Step 3) — still has a stripeSubscriptionId,
// just not currently in good standing. CANCELED = subscription ended,
// deliberately never deletes the user's task/decision history.
enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  hasOnboarded  Boolean  @default(false)
  createdAt     DateTime @default(now())

  // MonetizationPlan.md Step 1 — plan/billing state. `isPaidPlan()` /
  // `getTaskLimit()` in src/lib/billing/plan.ts are the ONLY place that
  // should ever interpret these fields; every gating check across the app
  // must go through those two functions, never a second ad-hoc comparison.
  plan                 Plan               @default(DEMO)
  subscriptionStatus   SubscriptionStatus @default(NONE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?

  tasks     Task[]
  decisions Decision[] @relation("DecisionActor")
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  workflowType  WorkflowType
  inboundText   String
  contextNotes  String?
  status        TaskStatus   @default(NEW)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  aiDrafts  AiDraft[]
  decisions Decision[]
  evalTags  EvalTag[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AiDraft {
  id               String   @id @default(cuid())
  taskId           String
  draftText        String
  confidenceScore  Float
  riskFlags        String[]
  reasoning        String
  rawJson          Json
  createdAt        DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model Decision {
  id            String         @id @default(cuid())
  taskId        String
  action        DecisionAction
  editedText    String?
  actorUserId   String
  createdAt     DateTime       @default(now())

  task      Task @relation(fields: [taskId], references: [id])
  actorUser User @relation("DecisionActor", fields: [actorUserId], references: [id])

  @@index([taskId])
  @@index([createdAt])
  @@index([action])
}

model EvalTag {
  id        String       @id @default(cuid())
  taskId    String
  tag       EvalTagValue
  createdAt DateTime     @default(now())

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

# Copy this file to .env.local and fill in real values. Never commit .env.local (already gitignored via .env*).

# Neon Postgres connection string (Step 0.3 in docs/MasterPrompts.md)
# Use the pooled connection string for DATABASE_URL and the direct connection string for DIRECT_URL if Neon provides both.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth.js (Step 0.5 in docs/MasterPrompts.md) — generate with:
# openssl rand -base64 32   (Mac/Linux/Git Bash)
# [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))   (Windows PowerShell)
AUTH_SECRET="replace-with-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API key (Step 0.4 in docs/MasterPrompts.md)
ANTHROPIC_API_KEY="sk-ant-replace-with-real-key"

# Stripe (MonetizationPlan.md / StripeSetupGuide.md) — use TEST-MODE keys
# (sk_test_..., whsec_test_... via `stripe listen`) for local dev and the
# Playwright suite; never point local/test env at live keys.
STRIPE_SECRET_KEY="sk_test_replace-with-real-key"
STRIPE_PUBLISHABLE_KEY="pk_test_replace-with-real-key"
STRIPE_WEBHOOK_SECRET="whsec_replace-with-real-secret"
STRIPE_PRICE_INDIVIDUAL_MONTHLY="price_replace-me"
STRIPE_PRICE_INDIVIDUAL_YEARLY="price_replace-me"
STRIPE_PRICE_PROFESSIONAL_MONTHLY="price_replace-me"
STRIPE_PRICE_PROFESSIONAL_YEARLY="price_replace-me"
